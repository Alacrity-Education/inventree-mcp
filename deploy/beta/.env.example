# Copied to .env by up.sh (with generated secrets). Edit .env, then re-run up.sh.
PUBLIC_HOST=i.beta.alacrity.ro
PG_PASS=generated
# role and database of the restored instance (pgdata/); up.sh sets the role's password to PG_PASS
DB_USER=inventree
DB_NAME=inventree
ADMIN_PASSWORD=generated

# The production InvenTree's Authentik client (the instance copy's social accounts use provider id "authentik"), with
# https://i.beta.alacrity.ro/accounts/authentik/login/callback/ added to its redirect URIs. Issuer without trailing
# slash, e.g. https://auth.alacrity.ro/application/o/inventree. Empty: SSO stays configured as in the database but
# cannot log anyone in (no client), so password login only.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_PROVIDER_ID=authentik
# Authentik group -> InvenTree group (JSON). Empty keeps the restored instance's map (Board, Clockworks, Everyone, ItAdmins, Volunteers).
SSO_GROUP_MAP=

# InvenTree groups (comma separated) that get the MCP view roles and may connect through MCP. Members are synced from
# Authentik at every login, so use mapped groups (a manual membership is removed at the next login).
MCP_GROUPS=ItAdmins
# 1 = allow the MCP write tools: the plugin setting MCP_READ_ONLY is switched off and the groups in MCP_GROUPS get all four
# MCP flags (view, add, change, delete) on part, part_category, stock and stock_location; view on every other role stays.
# 0 = keep MCP_READ_ONLY on (the write tools refuse every call). up.sh re-applies this at every run.
MCP_WRITE=1

# Caddy trusts X-Forwarded-For from these sources (the external proxy): "private_ranges" or IPs/CIDRs separated by spaces
TRUSTED_PROXIES=private_ranges

# 1 = load the InvenTree demo dataset on the first run (0: the stack runs off the restored instance copy)
DEMO_DATA=0
