From 9721dd46e1723d9d7b84c990b2d4dfed7c8bf194 Mon Sep 17 00:00:00 2001
From: lucaci32u4 <lucaci32u4@gmail.com>
Date: Thu, 15 Oct 2026 18:09:15 +0300
Subject: [PATCH] Expire model meta caches after a plugin registry reload

reload_plugins() re-populates the Django apps registry (registry._reload_apps)
while apps.ready is False, so the Apps.clear_cache() calls populate() makes
skip the per-model cache expiry. Relation trees and field caches built before
the reload then never learn about models registered during it.

Since #13007 the plugin package is purged from sys.modules on every collect,
so a plugin's models module is imported inside populate() rather than by
AppMixin._reregister_contrib_apps() afterwards (which reloaded it with the
registry ready, expiring the caches as a side effect). After a reload, core
models no longer know the plugin's foreign keys: reverse accessors are
missing and on_delete cascades are not collected, so deleting a Group or a
User referenced by a plugin table fails on the database constraint.

Call apps.clear_cache() once the registry is populated again.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/backend/InvenTree/plugin/registry.py    |  6 ++
 src/backend/InvenTree/plugin/test_plugin.py | 89 +++++++++++++++++++++
 2 files changed, 95 insertions(+)

diff --git a/src/backend/InvenTree/plugin/registry.py b/src/backend/InvenTree/plugin/registry.py
index 8f8a45018..41da965b0 100644
--- a/src/backend/InvenTree/plugin/registry.py
+++ b/src/backend/InvenTree/plugin/registry.py
@@ -1072,6 +1072,12 @@ class PluginsRegistry:
         else:
             self._try_reload(apps.set_installed_apps, loadable_apps)
 
+        # Both paths re-populate the registry while apps.ready is False, so the
+        # Apps.clear_cache() they run skips the per-model cache expiry: relation
+        # trees and field caches built before the reload would still miss the
+        # models registered during it (reverse accessors, on_delete cascades).
+        apps.clear_cache()
+
     def _clean_installed_apps(self):
         for plugin in self.installed_apps:
             if plugin in settings.INSTALLED_APPS:
diff --git a/src/backend/InvenTree/plugin/test_plugin.py b/src/backend/InvenTree/plugin/test_plugin.py
index f96f0ec26..7cd5ace49 100644
--- a/src/backend/InvenTree/plugin/test_plugin.py
+++ b/src/backend/InvenTree/plugin/test_plugin.py
@@ -687,6 +687,95 @@ class RegistryTests(TestQueryMixin, PluginRegistryMixin, TestCase):
             registry.registry_hash = 'abc'
             self.assertTrue(registry.check_reload())
 
+    @override_settings(PLUGIN_TESTING_SETUP=True)
+    def test_reload_expires_model_meta_caches(self):
+        """Relations to models registered during a reload are visible afterwards.
+
+        A reload re-populates the apps registry while apps.ready is False, so
+        the Apps.clear_cache() calls inside populate() skip the per-model cache
+        expiry. Relation trees cached before the reload would then never learn
+        about the models registered during it: reverse accessors are missing
+        and on_delete cascades are not collected, so deleting the core object
+        fails on the database constraint.
+        """
+        import sys
+
+        from django.apps import apps
+        from django.contrib.auth.models import Group
+
+        tmp = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+
+        pkg = 'inventree_relation_test_plugin'
+        src = tmp.joinpath(pkg)
+        src.mkdir()
+        src.joinpath('__init__.py').write_text('')
+        src.joinpath('models.py').write_text(
+            textwrap.dedent("""
+            from django.contrib.auth.models import Group
+            from django.db import models
+
+
+            class GroupNote(models.Model):
+                group = models.ForeignKey(
+                    Group, on_delete=models.CASCADE, related_name='relation_test_notes'
+                )
+
+                class Meta:
+                    app_label = 'inventree_relation_test_plugin'
+            """)
+        )
+        # The plugin module imports its models (as plugins with API views do):
+        # after a purge they are registered when the registry collects, before
+        # the apps registry is re-populated, so nothing expires the caches later
+        src.joinpath('core.py').write_text(
+            textwrap.dedent("""
+            from plugin import InvenTreePlugin
+            from plugin.mixins import AppMixin
+
+            from . import models  # noqa: F401
+
+
+            class RelationTestPlugin(AppMixin, InvenTreePlugin):
+                NAME = 'RelationTestPlugin'
+                SLUG = 'relation-test-plugin'
+                VERSION = '1.0.0'
+            """)
+        )
+        dist_info = tmp.joinpath(f'{pkg}-1.0.0.dist-info')
+        dist_info.mkdir()
+        dist_info.joinpath('METADATA').write_text(
+            f'Metadata-Version: 2.1\nName: {pkg}\nVersion: 1.0.0\n'
+        )
+        dist_info.joinpath('entry_points.txt').write_text(
+            f'[inventree_plugins]\nRelationTestPlugin = {pkg}.core:RelationTestPlugin\n'
+        )
+
+        def cleanup():
+            sys.path.remove(str(tmp))
+            for name in [n for n in sys.modules if n.split('.')[0] == pkg]:
+                del sys.modules[name]
+            apps.all_models.pop(pkg, None)
+            registry.reload_plugins(full_reload=True, collect=True)
+
+        self.enterContext(mock.patch.object(sys, 'dont_write_bytecode', True))
+        sys.path.insert(0, str(tmp))
+        self.addCleanup(cleanup)
+
+        def group_relations():
+            return [f.name for f in Group._meta.get_fields(include_hidden=True)]
+
+        self.assertNotIn('relation_test_notes', group_relations())
+
+        # First load: the package is imported while collecting
+        registry.reload_plugins(full_reload=True, collect=True)
+        self.assertIsNotNone(registry.get_plugin('relation-test-plugin', active=None))
+        self.assertIn('relation_test_notes', group_relations())
+
+        # Reload: the package is purged and imported again while collecting
+        registry.reload_plugins(full_reload=True, collect=True)
+        self.assertIn('relation_test_notes', group_relations())
+
     def test_check_reload_mismatch(self):
         """Test that a persistent registry hash mismatch is reported, rather than looping.
 
