-    callback_url: generateUrl(
-      `/${getBaseUrl()}/logged-in`,
-      window.location.origin
-    ),
+    callback_url: generateUrl(callback, window.location.origin),
     process: process,
     csrfmiddlewaretoken: getCsrfCookie()
   });
