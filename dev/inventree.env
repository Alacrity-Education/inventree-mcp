# InvenTree environment for the dev stack (committed; no real secrets, everything here is disposable).
INVENTREE_SITE_URL=http://localhost:8080
INVENTREE_WEB_PORT=8000
INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True

INVENTREE_PLUGINS_ENABLED=True
INVENTREE_PLUGINS_MANDATORY=inventree-mcp
INVENTREE_AUTO_UPDATE=True
INVENTREE_DEBUG=True
INVENTREE_LOG_LEVEL=INFO

INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=admin
INVENTREE_ADMIN_EMAIL=admin@example.test

INVENTREE_EMAIL_HOST=mailpit
INVENTREE_EMAIL_PORT=1025
INVENTREE_EMAIL_SENDER=inventree@example.test

INVENTREE_CORS_ORIGIN_WHITELIST=https://claude.ai,https://claude.com
INVENTREE_TIMEZONE=Europe/Bucharest

INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=db
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=inventree

INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=cache
INVENTREE_CACHE_PORT=6379

INVENTREE_GUNICORN_TIMEOUT=90
