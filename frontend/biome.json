{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "root": true,
  "files": { "includes": ["src/**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "rules": {
      "suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off", "noParameterAssign": "off" },
      "correctness": { "useExhaustiveDependencies": "off", "noUnusedImports": "error" }
    }
  }
}
